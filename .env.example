# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://movie:movie@localhost:5432/movie_platform
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# TMDB (use the API Read Access Token; it is sent only as a Bearer header)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# Supabase (Phase 2; leave blank for Phase 0/1 local development)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Browser-visible API origin (never put server secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Next.js proxy target; use http://api:8000 inside Compose
API_INTERNAL_URL=http://localhost:8000
