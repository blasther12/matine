{
  "name": "matine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @matine/web dev",
    "build": "pnpm --filter @matine/web build",
    "lint": "pnpm --filter @matine/web lint",
    "typecheck": "pnpm --filter @matine/web typecheck",
    "test": "pnpm --filter @matine/web test",
    "audit:frontend": "pnpm audit --audit-level high"
  }
}
